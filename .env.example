# Copia este archivo a ".env" y completa los valores antes de iniciar el servidor

PORT=3000

# Credenciales del panel administrativo (cámbialas antes de publicar el sitio)
ADMIN_USER=admin
ADMIN_PASSWORD=cambiar123

# Clave secreta para firmar la cookie de sesión del admin (usa un texto largo y aleatorio en producción)
COOKIE_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# ---------------------------------------------------------------------------
# Carpeta donde se guardan la base de datos local y las fotos/videos subidos.
# En local no hace falta tocar esto (usa "storage/" dentro del proyecto).
# En Railway/Render: poné acá la MISMA ruta donde montaste el volumen/disco
# persistente (por ejemplo /data). Ver el README para el paso a paso.
# STORAGE_DIR=/data

# ---------------------------------------------------------------------------
# Base de datos remota (Turso) — SOLO necesario si vas a publicar en Vercel.
# En local, Railway, Render o un VPS podés dejar estas dos líneas vacías/comentadas:
# el sitio va a usar un archivo local (STORAGE_DIR/store.db) automáticamente.
# Guía: https://docs.turso.tech/sdk/ts/quickstart (creá una base gratis y copiá estos valores)
# TURSO_DATABASE_URL=libsql://tu-base-tu-usuario.turso.io
# TURSO_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Almacenamiento de fotos/videos (Vercel Blob) — SOLO necesario si vas a publicar en Vercel.
# En local, Railway, Render o un VPS podés dejarlo vacío: las fotos se guardan
# directo en public/uploads/. En Vercel, creá un "Blob Store" desde el dashboard
# del proyecto y esta variable se completa sola al conectarlo.
# BLOB_READ_WRITE_TOKEN=
