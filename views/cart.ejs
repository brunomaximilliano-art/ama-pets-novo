<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head', { pageTitle: 'Carrito' }) %>
</head>
<body>
  <%- include('partials/header', { showBack: true }) %>

  <main class="main cart-page">
    <h1 class="page-title" id="cart-title">Carrito</h1>

    <div id="cart-empty" class="empty-state" hidden>
      <p>Tu carrito está vacío.</p>
      <a href="/" class="btn btn--primary">Ver productos</a>
    </div>

    <div id="cart-items" class="cart-items"></div>

    <div id="cart-details" hidden>
      <div class="cart-actions">
        <button type="button" id="btn-clear-cart" class="link-btn">Vaciar carrito</button>
        <a href="/" class="link-btn">Ver más productos ›</a>
      </div>

      <label class="field-label" for="observation">Observación</label>
      <textarea id="observation" maxlength="200" rows="3" placeholder="Escribe aquí la observación de tu pedido"></textarea>
      <p class="char-count"><span id="obs-count">0</span>/200</p>

      <h2 class="section-title">Forma de entrega</h2>
      <div class="delivery-options">
        <label class="delivery-option">
          <input type="radio" name="delivery" value="entrega" id="delivery-entrega" autocomplete="off" />
          <span class="delivery-option__icon">🚚</span>
          <span>
            <strong>Entrega</strong>
            <p class="delivery-option__note"><%= settings.delivery_note %></p>
            <div id="courier-chosen" class="courier-chosen" hidden></div>
          </span>
          <span class="chevron">›</span>
        </label>
      </div>
    </div>

    <div class="cart-summary" id="cart-summary" hidden>
      <div class="cart-summary__row cart-summary__row--total">
        <span>Total:</span>
        <strong id="cart-total">$ 0,00</strong>
      </div>
      <button type="button" id="btn-continue" class="btn btn--primary btn--block">Continuar para finalizar</button>
    </div>
  </main>

  <!-- Modal de selección de transportadora -->
  <div class="modal" id="courier-modal" hidden>
    <div class="modal__panel">
      <div class="modal__head">
        <h3>Elige la opción de entrega</h3>
        <button type="button" id="courier-modal-close" class="icon-btn">&times;</button>
      </div>
      <div id="courier-list" class="courier-list"></div>
      <button type="button" id="courier-select-btn" class="btn btn--primary btn--block">Seleccionar</button>
    </div>
  </div>

  <script>
    window.__COURIERS__ = <%- JSON.stringify(couriers) %>;
  </script>
  <%- include('partials/footer') %>
  <script src="/js/cart-page.js" defer></script>
</body>
</html>
