<!DOCTYPE html>
<html lang="es">
<head>
  <%- include('partials/head') %>
</head>
<body>
  <%- include('partials/header') %>

  <main class="main">
    <% var hasHeroText = settings.hero_title || settings.hero_subtitle; %>
    <% if (settings.hero_image) { %>
      <section class="hero hero--photo" style="background-image:url('<%= settings.hero_image %>')">
        <% if (hasHeroText) { %>
          <div class="hero__overlay">
            <% if (settings.hero_title) { %><h1 class="hero__title"><%= settings.hero_title %> <span class="hero__heart">♡</span></h1><% } %>
            <% if (settings.hero_subtitle) { %><p class="hero__subtitle"><%= settings.hero_subtitle %></p><% } %>
          </div>
        <% } %>
      </section>
    <% } else { %>
      <section class="hero hero--placeholder">
        <div class="hero__paws">🐾 🐾 🐾</div>
        <h1 class="hero__title"><%= settings.hero_title || 'Todo para su bienestar' %> <span class="hero__heart">♡</span></h1>
        <% if (settings.hero_subtitle) { %><p class="hero__subtitle"><%= settings.hero_subtitle %></p><% } %>
      </section>
    <% } %>

    <% if (!sections.length) { %>
      <div class="empty-state">
        <p>Todavía no hay productos cargados.</p>
        <p class="empty-state__muted">Agregalos desde el panel administrativo en <code>/admin</code>.</p>
      </div>
    <% } else { %>
      <div class="view-toggle">
        <button type="button" class="view-toggle__btn" data-view="grid" aria-label="Ver en grilla">▦</button>
        <button type="button" class="view-toggle__btn" data-view="list" aria-label="Ver en lista">☰</button>
      </div>
    <% } %>

    <% sections.forEach(function(section) { %>
      <section class="category-section">
        <div class="category-section__head">
          <h2><%= section.category.name %></h2>
          <a href="/c/<%= section.category.slug %>" class="see-all">Ver todo (<%= section.total %>)</a>
        </div>
        <div class="product-grid">
          <% section.products.forEach(function(product) { %>
            <%- include('partials/product-card', { product: product }) %>
          <% }) %>
        </div>
        <a href="/c/<%= section.category.slug %>" class="see-all see-all--block">Ver todo de <%= section.category.name %></a>
      </section>
    <% }) %>
  </main>

  <%- include('partials/footer') %>
</body>
</html>
