  <footer class="site-footer">
    <div class="site-footer__social">
      <a
        class="social-btn"
        href="https://wa.me/<%= settings.whatsapp_number %>"
        target="_blank"
        rel="noopener"
        aria-label="WhatsApp"
      ><img src="/img/icons/icon-whatsapp.png" alt="WhatsApp" /></a>
      <a
        class="social-btn"
        href="https://instagram.com/<%= (settings.instagram_handle || '@amapets.uy').replace(/^@/, '') %>"
        target="_blank"
        rel="noopener"
        aria-label="Instagram"
      ><img src="/img/icons/icon-instagram.png" alt="Instagram" /></a>
      <a
        class="social-btn"
        href="https://www.tiktok.com/@<%= (settings.tiktok_handle || '@amapets.uy').replace(/^@/, '') %>"
        target="_blank"
        rel="noopener"
        aria-label="TikTok"
      ><img src="/img/icons/icon-tiktok.png" alt="TikTok" /></a>
    </div>
    <p class="site-footer__handles">
      WhatsApp · Instagram <%= settings.instagram_handle || '@amapets.uy' %> · TikTok <%= settings.tiktok_handle || '@amapets.uy' %>
    </p>
    <p>Catálogo online de <strong><%= settings.store_name %></strong></p>
    <p class="site-footer__muted">Todos los productos y ofertas de este catálogo son responsabilidad de <%= settings.store_name %>.</p>
  </footer>

  <div class="cart-bar" id="cart-bar" hidden>
    <div class="cart-bar__info">
      <span class="cart-bar__total" id="cart-bar-total">$ 0,00</span>
      <span class="cart-bar__count" id="cart-bar-count">0 artículos</span>
    </div>
    <a href="/carrito" class="btn btn--primary">Ver carrito</a>
  </div>

  <script src="/js/cart.js" defer></script>
  <script src="/js/site.js" defer></script>
