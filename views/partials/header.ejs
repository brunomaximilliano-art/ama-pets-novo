<div class="cookie-banner" id="cookie-banner" hidden>
  <p>Usamos cookies para mejorar tu experiencia en el sitio.</p>
  <button type="button" id="cookie-accept">Aceptar y cerrar</button>
</div>

<!-- Menú fijo de escritorio/laptop: queda siempre visible al costado en
     pantallas grandes (no hace falta tocar el hambúrguer ahí). En celular
     queda oculto del todo — ahí se usa el ☰ + la gaveta lateral de abajo. -->
<aside class="side-sidebar" id="side-sidebar">
  <a href="/" class="side-sidebar__logo">
    <img src="<%= settings.logo_path %>" alt="<%= settings.store_name %>" />
  </a>

  <div class="side-card">
    <h3 class="side-card__title">Contacto</h3>
    <a class="side-card__row" href="https://wa.me/<%= settings.whatsapp_number %>" target="_blank" rel="noopener">
      <img src="/img/icons/icon-whatsapp.png" alt="" class="side-card__icon" /> +<%= settings.whatsapp_number %>
    </a>
    <% if (settings.store_address) { %>
      <p class="side-card__row side-card__row--text">
        <span class="side-card__icon side-card__icon--emoji">📍</span> <%= settings.store_address %>
      </p>
    <% } %>
  </div>

  <div class="side-card side-card--categories">
    <h3 class="side-card__title">Categorías</h3>
    <a href="/" class="side-card__cat <%= !activeCategory ? 'is-active' : '' %>">
      <img src="/img/icons/icon-inicio.png" alt="" class="side-card__cat-icon" /> Inicio
    </a>
    <% categories.forEach(function(c) { var ic = categoryIcon(c.name); %>
      <a href="/c/<%= c.slug %>" class="side-card__cat <%= activeCategory === c.slug ? 'is-active' : '' %>">
        <img src="<%= ic.image %>" alt="" class="side-card__cat-icon" /> <%= c.name %>
      </a>
    <% }) %>
  </div>

  <div class="side-card">
    <h3 class="side-card__title">Opciones de entrega</h3>
    <p class="side-card__delivery">🚚 <strong>Entrega</strong></p>
    <p class="side-card__delivery-note"><%= settings.delivery_note %></p>
  </div>
</aside>

<header class="site-header">
  <div class="site-header__top">
    <% if (typeof showBack !== 'undefined' && showBack) { %>
      <a href="javascript:history.back()" class="icon-btn" aria-label="Volver">&#8592;</a>
    <% } else { %>
      <button type="button" class="icon-btn" id="menu-toggle" aria-label="Abrir menú">&#9776;</button>
    <% } %>
    <a href="/" class="site-logo">
      <img src="<%= settings.logo_path %>" alt="<%= settings.store_name %>" />
    </a>
    <div class="site-header__icons">
      <button type="button" class="icon-btn" id="search-toggle" aria-label="Buscar">
        <img src="/img/icons/icon-search.png" alt="" class="icon-btn__img" />
      </button>
      <a href="/carrito" class="icon-btn cart-icon" aria-label="Carrito">
        <img src="/img/icons/icon-cart.png" alt="" class="icon-btn__img" />
        <span class="cart-badge" id="cart-badge" hidden>0</span>
      </a>
    </div>
  </div>

  <form class="site-search" id="site-search" action="/buscar" method="get" hidden>
    <input
      type="search"
      name="q"
      id="site-search-input"
      placeholder="Buscar en toda la tienda..."
      autocomplete="off"
      value="<%= typeof query !== 'undefined' && query ? query : '' %>"
    />
    <button type="submit" class="icon-btn" aria-label="Buscar">
      <img src="/img/icons/icon-search.png" alt="" class="icon-btn__img" />
    </button>
  </form>

  <nav class="category-nav">
    <a href="/" class="chip <%= !activeCategory ? 'chip--active' : '' %>">Inicio</a>
    <% categories.forEach(function(c) { %>
      <a href="/c/<%= c.slug %>" class="chip <%= activeCategory === c.slug ? 'chip--active' : '' %>"><%= c.name %></a>
    <% }) %>
  </nav>
</header>

<!-- Menú lateral (hambúrguer) para celular: la misma navegación por
     categorías que el menú fijo de arriba, pero como gaveta que se abre —
     en pantallas grandes no hace falta porque el menú de al lado ya está
     siempre visible. -->
<div class="nav-drawer-backdrop" id="nav-drawer-backdrop" hidden></div>
<nav class="nav-drawer" id="nav-drawer" hidden aria-label="Menú de categorías">
  <div class="nav-drawer__head">
    <span class="nav-drawer__title"><%= settings.store_name %></span>
    <button type="button" class="icon-btn" id="nav-drawer-close" aria-label="Cerrar menú">&times;</button>
  </div>
  <div class="nav-drawer__links">
    <a href="/" class="nav-drawer__link">
      <img src="/img/icons/icon-inicio.png" alt="" class="nav-drawer__dot nav-drawer__dot--img" /> Inicio
    </a>
    <% categories.forEach(function(c) { var ic = categoryIcon(c.name); %>
      <a href="/c/<%= c.slug %>" class="nav-drawer__link">
        <img src="<%= ic.image %>" alt="" class="nav-drawer__dot nav-drawer__dot--img" /> <%= c.name %>
      </a>
    <% }) %>
  </div>
  <div class="nav-drawer__foot">
    
      href="https://wa.me/<%= settings.whatsapp_number %>"
      target="_blank"
      rel="noopener"
      class="nav-drawer__whatsapp"
    >
      <img src="/img/icons/icon-whatsapp.png" alt="" class="nav-drawer__whatsapp-icon" /> Escribinos por WhatsApp
    </a>
  </div>
</nav>
